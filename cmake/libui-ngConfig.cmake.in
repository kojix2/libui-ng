@PACKAGE_INIT@

if(UNIX AND NOT APPLE)
	find_package(PkgConfig REQUIRED)
	pkg_check_modules(GTK3 REQUIRED IMPORTED_TARGET "gtk+-3.0>=3.18")
endif()

if(APPLE AND NOT TARGET libui::AppleDependencies)
	find_library(_libui_foundation Foundation)
	find_library(_libui_appkit AppKit)
	find_library(_libui_objc objc)
	if(NOT _libui_foundation OR NOT _libui_appkit OR NOT _libui_objc)
		set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
		set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
			"Foundation, AppKit, and the Objective-C runtime are required")
		return()
	endif()
	add_library(libui::AppleDependencies INTERFACE IMPORTED)
	set_property(TARGET libui::AppleDependencies PROPERTY INTERFACE_LINK_LIBRARIES
		"${_libui_foundation};${_libui_appkit};${_libui_objc}")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/libui-ngTargets.cmake")
check_required_components(libui-ng)
